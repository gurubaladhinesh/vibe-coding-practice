# Copy this file to `.env.local` and fill in a real key for Ollama scoring.
# If OLLAMA_API_KEY is missing, the API still parses PDFs and returns mock scores.
OLLAMA_API_KEY=

# Cloud API host (default). For a local daemon, use http://127.0.0.1:11434
OLLAMA_HOST=https://ollama.com

# Optional. Defaults to gpt-oss:120b, then llama3.1 / qwen2.5 as fallbacks.
OLLAMA_MODEL=gpt-oss:120b
